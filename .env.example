# Reference only: Java/Tomcat does not load .env files automatically.
# Set these variables in the environment of the Tomcat/Java process.
LIAS_DB_URL=jdbc:mysql://127.0.0.1:3306/lias_data_base?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LIAS_DB_USER=root
LIAS_DB_PASSWORD=
# XAMPP local default is empty. If MySQL has a password, set it locally.
LIAS_UPLOAD_DIR=C:/path/to/Liasee/storage/uploads
# Optional: generate a private random value of at least 32 characters.
# If omitted, the application generates a new signing key at startup.
# LIAS_JWT_SECRET=
# Optional after all legacy accounts have migrated:
# LIAS_LEGACY_PASSWORDS=false

# Test fixture tools require private passwords of at least 12 characters.
# Fill locally; empty values deliberately fail validation.
LIAS_TEST_PASSWORD=
LIAS_TEST_DIRECTOR_PASSWORD=
LIAS_TEST_BASE=http://127.0.0.1:18080/Lias-Jee/
LIAS_TEST_DB=lias_test_publish_review
LIAS_TEST_DB_PORT=33307
LIAS_TEST_DB_USER=root
LIAS_TEST_MYSQL=C:/xampp/mysql/bin/mysql.exe
# MySQL CLI scripts use MYSQL_PWD for a password-protected test server.
# MYSQL_PWD=
