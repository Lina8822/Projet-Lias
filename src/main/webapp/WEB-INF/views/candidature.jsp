<%@ page pageEncoding="UTF-8" %>
<%@ include file="/includes/header.jspf" %><div class="auth-layout"><aside class="auth-aside"><a class="brand" href="<%=ctx%>/index.jsp"><img src="<%=ctx%>/assets/images/lias.svg" alt=""><span>LIAS<small>REJOIGNEZ LE LABORATOIRE</small></span></a><h1>De nouvelles idées.<br>Un projet commun.</h1><p>Présentez votre parcours et vos motivations. Votre dossier sera examiné par la direction du laboratoire.</p><a class="btn" href="<%=ctx%>/login.jsp">Déjà membre ? Se connecter</a></aside><main id="main" class="auth-main candidate"><p class="eyebrow">CANDIDATURE</p><h1>Rejoindre le LIAS</h1><p class="muted">Tous les champs sont obligatoires. Le CV doit être au format PDF, 10 Mo maximum.</p><%@ include file="/includes/flash.jspf" %><form action="<%=ctx%>/CandidatureServlet" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><div class="form-grid"><% String[][] inputs={{"nom","Nom","text"},{"prenom","Prénom","text"},{"email","Email","email"},{"etablissement","Établissement","text"},{"laboratoire","Laboratoire d’origine","text"}};for(String[] input:inputs){ %><div class="field"><label for="<%=input[0]%>"><%=input[1]%></label><input id="<%=input[0]%>" name="<%=input[0]%>" type="<%=input[2]%>" maxlength="254" required></div><% } %><div class="field"><label for="statut">Statut demandé</label><select name="statut_demande" id="statut" required><option value="PERMANENT">Membre permanent</option><option value="ASSOCIE">Membre associé</option><option value="DOCTORANT">Doctorant</option></select></div><div class="field wide"><label for="motivation">Votre motivation</label><textarea id="motivation" name="motivation" required maxlength="10000" placeholder="Vos travaux, vos intérêts et votre projet au LIAS…"></textarea></div><div class="field wide"><label for="cv">Curriculum vitae</label><input id="cv" name="fichier" type="file" accept="application/pdf" required></div><div class="field wide"><label for="password">Choisissez votre mot de passe (12 caractères minimum)</label><div class="password-field"><input id="password" name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required><button type="button" data-password="password">Afficher</button></div><small>Ce mot de passe permettra la connexion après acceptation de votre candidature.</small></div></div><div class="form-actions"><button class="primary">Envoyer ma candidature</button></div></form><section class="card"><h2>Suivre une candidature</h2><p class="muted">Consultez la décision avec l’email et le mot de passe choisis lors du dépôt.</p><form method="post" action="<%=ctx%>/SuiviCandidatureServlet"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><label for="suivi-email">Email du dossier</label><input type="email" id="suivi-email" name="email" required><label for="suivi-pass">Mot de passe du dossier</label><input type="password" id="suivi-pass" name="password" required><div class="form-actions"><button>Consulter la décision</button></div></form></section></main></div></body></html>
