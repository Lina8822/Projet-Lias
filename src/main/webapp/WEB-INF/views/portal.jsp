<%@ page pageEncoding="UTF-8" %>
<%@ include file="/includes/header.jspf" %><%@ include file="/includes/sidebar.jspf" %><div class="shell"><%@ include file="/includes/navbar.jspf" %><main class="content" id="main"><div class="page-heading"><div><p class="eyebrow">ESPACE SCIENTIFIQUE</p><h1><%=Page.e(p.title)%></h1><p><%=Page.e(p.subtitle)%></p></div><% if(p.key.equals("dashboard")){ %><span class="badge"><%=java.time.LocalDate.now()%></span><% } %></div><%@ include file="/includes/flash.jspf" %>
<% if(p.key.equals("rapport")){ %><form method="get" class="toolbar no-print"><label for="year">Année</label><input id="year" type="number" name="annee" min="1900" max="<%=java.time.Year.now().getValue()+1%>" value="<%=Page.e(request.getParameter("annee")==null?java.time.Year.now():request.getParameter("annee"))%>" required><button class="primary">Générer le rapport</button><% if(Access.direction(user)){ %><button formaction="<%=ctx%>/RapportPdfServlet">Exporter en PDF</button><% } %><button type="button" data-print>Imprimer</button></form><% } %>
<% if(!p.stats.isEmpty()){ %><div class="stats"><% for(var stat:p.stats.entrySet()){ %><article class="card stat"><span class="stat-icon" aria-hidden="true">◈</span><strong><%=stat.getValue()%></strong><span><%=Page.e(stat.getKey())%></span></article><% } %></div><% } %>
<% if(!p.profile.isEmpty()){ %><section class="card"><div class="profile-top"><% if(p.profile.get("photo")!=null&&!p.profile.get("photo").toString().isBlank()){ %><img class="avatar" src="<%=ctx%>/PhotoServlet?id=<%=Page.e(p.profile.get("id"))%>" alt="Photo de profil"><% }else{ %><span class="avatar">◎</span><% } %><div><h2><%=Page.e(p.profile.get("prenom"))%> <%=Page.e(p.profile.get("nom"))%></h2><span class="badge"><%=Page.e(p.profile.get("statut_actuel"))%></span> <span class="badge"><%=Page.e(p.profile.get("role"))%></span></div></div><dl class="profile-details"><% String[][] fields={{"email","Email"},{"equipe","Équipe"},{"etablissement","Établissement"},{"laboratoire","Laboratoire d’origine"},{"date_affiliation","Affiliation"},{"biographie","Biographie"},{"centre_interet","Centres d’intérêt"}};for(String[] field:fields){ %><div><dt><%=field[1]%></dt><dd><%=Page.e(p.profile.get(field[0]))%></dd></div><% } %></dl></section><% } %>
<% if(p.key.equals("dashboard")&&!p.calendar.isEmpty()){var next=p.calendar.stream().filter(ev->ev.get("debut")!=null&&ev.get("debut").toString().compareTo(java.time.LocalDate.now().toString())>=0).min(Comparator.comparing(ev->ev.get("debut").toString()));if(next.isPresent()){var ev=next.get(); %><section class="card"><p class="eyebrow">À L’AGENDA</p><h2><%=Page.e(ev.get("titre"))%></h2><p class="muted"><%=Page.e(ev.get("debut"))%> · <%=Page.e(ev.get("lieu"))%></p><a href="<%=ctx%>/calendrier.jsp">Voir le calendrier →</a></section><% }} %>
<% if(p.key.equals("calendrier")){ %><section class="card" data-calendar><div class="calendar-toolbar"><h2 data-calendar-title>Calendrier</h2><button data-calendar-step="-1" aria-label="Période précédente">←</button><button data-today>Aujourd’hui</button><button data-calendar-step="1" aria-label="Période suivante">→</button><button data-view="month">Mois</button><button data-view="week">Semaine</button><button data-view="day">Jour</button></div><div class="calendar-grid"></div><% for(var ev:p.calendar){ %><span hidden data-event data-title="<%=Page.e(ev.get("titre"))%>" data-start="<%=Page.e(ev.get("debut"))%>" data-end="<%=Page.e(ev.get("fin"))%>" data-type="<%=Page.e(ev.get("type"))%>" data-place="<%=Page.e(ev.get("lieu"))%>" data-url="<%=ctx%>/<%=Page.e(ev.get("lien"))%>"></span><% } %></section><dialog id="event-dialog"><h2></h2><p></p><a class="btn primary" href="evenements.jsp">Voir les détails</a> <button>Fermer</button></dialog><noscript>JavaScript est nécessaire pour naviguer dans le calendrier. Les dates restent consultables dans Événements.</noscript><% } %>
<% if(p.key.equals("messagerie")){ %><section class="card chat-layout"><nav class="conversation-list" aria-label="Conversations"><h2>Conversations</h2><a href="<%=ctx%>/messagerie.jsp">◎ Laboratoire</a><% for(var person:p.choices.getOrDefault("membres",List.of())){if(person.get("id").toString().equals(String.valueOf(user.getIdMembre())))continue; %><a href="<%=ctx%>/messagerie.jsp?destinataire_id=<%=Page.e(person.get("id"))%>"><%=Page.e(person.get("label"))%></a><% } %><h3>Équipes</h3><% for(var team:p.choices.getOrDefault("mes_equipes",List.of())){ %><a href="<%=ctx%>/messagerie.jsp?equipe_id=<%=Page.e(team.get("id"))%>"><%=Page.e(team.get("label"))%></a><% } %><h3>Événements</h3><% for(var ev:p.choices.getOrDefault("evenements",List.of())){ %><a href="<%=ctx%>/messagerie.jsp?evenement_id=<%=Page.e(ev.get("id"))%>"><%=Page.e(ev.get("label"))%></a><% } %></nav><div class="chat-messages" aria-label="Messages"><% if(p.chat.isEmpty()){ %><div class="empty">Commencez la conversation.</div><% }for(var msg:p.chat){boolean mine=msg.get("id_expediteur").toString().equals(String.valueOf(user.getIdMembre())); %><article class="bubble <%=mine?"mine":""%>"><strong><%=Page.e(msg.get("expediteur"))%></strong><p><%=Page.e(msg.get("contenu"))%></p><small><%=Page.e(msg.get("date_envoi"))%> · <%=Page.e(msg.get("lecture"))%></small><% if(!mine&&"NON LU".equals(msg.get("lecture"))){ %><form method="post" action="<%=ctx%>/MessageServlet"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><input type="hidden" name="action" value="lire"><input type="hidden" name="id" value="<%=Page.e(msg.get("id_message"))%>"><button>Marquer comme lu</button></form><% } %></article><% } %></div></section><% } %>
<% for(Block block:p.blocks){ %><%@ include file="/includes/table.jspf" %><% } %>
<% int formIndex=0;for(Form form:p.forms){formIndex++; %><%@ include file="/includes/form.jspf" %><% } %>
<% session.removeAttribute("formValues"); %></main><%@ include file="/includes/footer.jspf" %></div></body></html>

