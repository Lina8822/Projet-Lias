<%@ page pageEncoding="UTF-8" %>
<header class="topbar"><button class="menu-toggle" aria-label="Ouvrir la navigation" aria-controls="sidebar" aria-expanded="false">☰</button>
<% if(user!=null){ %><form class="global-search" action="<%=ctx%>/recherche.jsp" method="get"><label class="sr-only" for="global-q">Recherche globale</label><input id="global-q" name="q" maxlength="200" placeholder="Rechercher dans le laboratoire…" value="<%=Page.e(request.getParameter("q"))%>"><button type="submit">Rechercher</button></form>
<div class="account"><details class="notifications"><summary aria-label="Notifications">🔔 <span class="badge"><%=p.notifications.stream().filter(n->"NON LUE".equals(n.get("lecture"))).count()%></span></summary><div class="notification-menu"><h3>Notifications</h3><% if(p.notifications.isEmpty()){ %><p class="muted">Vous êtes à jour.</p><% }for(var n:p.notifications.stream().limit(5).toList()){ %><div class="notification-item"><a href="<%=ctx%>/<%=Page.e(PageServlet.safeLink(n.get("lien")))%>"><%=Page.e(n.get("message"))%></a><p><small><%=Page.e(n.get("date_creation"))%></small></p><% if("NON LUE".equals(n.get("lecture"))){ %><form method="post" action="<%=ctx%>/NotificationServlet"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><input type="hidden" name="id" value="<%=Page.e(n.get("id_notif"))%>"><button>Marquer comme lue</button></form><% } %></div><% } %><p><a href="<%=ctx%>/notifications.jsp">Toutes les notifications →</a></p></div></details><span class="avatar" aria-hidden="true"><%=Page.e(user.getPrenom().isEmpty()?"L":user.getPrenom().substring(0,1))%></span><span class="account-name"><strong><%=Page.e(user.getPrenom()+" "+user.getNom())%></strong><br><small><%=Page.e(user.getRoleActuel())%></small></span><form method="post" action="<%=ctx%>/LogoutServlet"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><button title="Déconnexion">Quitter</button></form></div>
<% }else{ %><span class="muted">Portail public · LIAS</span><a class="btn primary" href="<%=ctx%>/login.jsp">Se connecter</a><% } %></header>
