<%@ page pageEncoding="UTF-8" %>
<% boolean hasActions=block.rows().stream().anyMatch(row->!row.actions().isEmpty()); %><section class="card data-block"><h2><%=Page.e(block.title())%></h2>
<% if(block.rows().isEmpty()){ %><div class="empty">Aucune donnée à afficher pour le moment.</div><% }else{ %>
<div class="toolbar no-print"><input type="search" data-search placeholder="Rechercher dans ce tableau…" aria-label="Rechercher dans <%=Page.e(block.title())%>"></div><div class="table-wrap"><table><thead><tr><% for(var col:block.columns().entrySet()){boolean filter=Set.of("statut_actuel","role_actuel","equipe","equipe_id","annee","type_event","type_doc","etat_demande","etat_calcule","etat","statut","auteurs").contains(col.getKey()); %><th scope="col" <%=filter?"data-filter":""%>><button type="button" title="Trier"><%=Page.e(col.getValue())%> ↕</button></th><% } %><% if(hasActions){ %><th scope="col" class="no-print">Actions</th><% } %></tr></thead><tbody>
<% for(Row row:block.rows()){ %><tr><% for(var col:block.columns().entrySet()){Object value=row.values().get(col.getKey());String text=value==null?"":value.toString();boolean badge=Set.of("statut_actuel","role_actuel","etat_demande","etat_calcule","etat","statut","lecture","type_doc","type_event").contains(col.getKey()); %><td class="<%=text.length()>160?"long":""%>"><% if(col.getKey().equals("photo")){if(!text.isBlank()){ %><img class="avatar" loading="lazy" alt="Photo du membre" src="<%=ctx%>/PhotoServlet?id=<%=Page.e(row.values().get("id"))%>"><% }else{ %><span class="avatar" aria-hidden="true">◎</span><% }}else if(badge){ %><span class="badge" data-state="<%=Page.e(text)%>"><%=Page.e(text.replace('_',' '))%></span><% }else{ %><%=text.isBlank()?"—":Page.e(text)%><% } %></td><% } %><% if(hasActions){ %><td class="no-print"><div class="actions"><% for(Action a:row.actions()){if(a.post()){ %><form method="post" action="<%=ctx%>/<%=Page.e(a.endpoint())%>" data-confirm="<%=Page.e(a.confirm())%>"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><% for(var hidden:a.params().entrySet()){ %><input type="hidden" name="<%=Page.e(hidden.getKey())%>" value="<%=Page.e(hidden.getValue())%>"><% } %><button type="submit"><%=Page.e(a.label())%></button></form><% }else{ %><a class="btn" href="<%=a.endpoint().startsWith("http")?"":ctx+"/"%><%=Page.e(Page.url(a))%>"><%=Page.e(a.label())%></a><% }} %></div></td><% } %></tr><% } %></tbody></table></div><p class="empty" data-no-results hidden>Aucun résultat ne correspond à vos filtres.</p><div class="pagination no-print"><span data-page-status></span><button type="button" data-prev>← Précédent</button><button type="button" data-next>Suivant →</button></div><% } %></section>
