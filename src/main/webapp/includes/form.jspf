<%@ page pageEncoding="UTF-8" %>
<details class="card form-card no-print" <%=form.values().isEmpty()?"":"open"%>><summary><%=Page.e(form.title())%></summary><form action="<%=ctx%>/<%=Page.e(form.endpoint())%>" method="post" <%=form.multipart()?"enctype=\"multipart/form-data\"":""%> data-confirm="<%=Set.of("CompteServlet","MandatServlet").contains(form.endpoint())?"Confirmer cette modification ? Elle sera historisée.":""%>"><input type="hidden" name="csrf" value="<%=Page.e(session.getAttribute("csrf"))%>"><% for(var hidden:form.hidden().entrySet()){ %><input type="hidden" name="<%=Page.e(hidden.getKey())%>" value="<%=Page.e(hidden.getValue())%>"><% } %><div class="form-grid">
<% for(Field field:form.fields()){String fid="f"+formIndex+"-"+field.name();Object raw=form.values().get(field.name()); Object retained=session.getAttribute("formValues");if(retained instanceof Map){Map<?,?> previous=(Map<?,?>)retained;if(Objects.equals(previous.get("action"),form.hidden().get("action"))&&previous.containsKey(field.name()))raw=previous.get(field.name());}String value=raw==null?"":raw.toString();if(field.type().equals("datetime-local"))value=value.replace(' ','T');if(field.type().equals("select")&&(raw instanceof Boolean))value=Boolean.TRUE.equals(raw)?"1":"0"; %><div class="field <%=field.type().equals("textarea")?"wide":""%>"><label for="<%=fid%>"><%=Page.e(field.label())%><%=field.required()?" *":""%></label>
<% if(field.type().equals("textarea")){ %><textarea id="<%=fid%>" name="<%=Page.e(field.name())%>" maxlength="10000" <%=field.required()?"required":""%>><%=Page.e(value)%></textarea>
<% }else if(Set.of("select","reference").contains(field.type())){ %><select id="<%=fid%>" name="<%=Page.e(field.name())%>" <%=field.required()?"required":""%>><option value="">Choisir…</option><% if(field.type().equals("select")){for(String option:field.options().split(",")){ %><option value="<%=Page.e(option)%>" <%=value.equals(option)?"selected":""%>><%=Page.e(option.replace('_',' '))%></option><% }}else{for(var option:p.choices.getOrDefault(field.options(),List.of())){ %><option value="<%=Page.e(option.get("id"))%>" <%=value.equals(String.valueOf(option.get("id")))?"selected":""%>><%=Page.e(option.get("label"))%></option><% }} %></select>
<% }else{String type=field.type().equals("year")?"number":field.type(); %><input id="<%=fid%>" name="<%=Page.e(field.name())%>" type="<%=type%>" <%=field.type().equals("file")?"accept=\""+Page.e(field.options())+"\"":"value=\""+Page.e(value)+"\""%> <%=field.required()?"required":""%> <%=type.equals("number")?"min=\"1\" step=\"1\"":""%> <%=Set.of("text","email").contains(type)?"maxlength=\"255\"":""%>><% } %></div><% } %></div><div class="form-actions"><button class="primary" type="submit">Enregistrer</button><small>* Champs obligatoires</small></div></form></details>
